[Unit]
Description=Flask Application
After=network.target

[Service]
WorkingDirectory=/home/wapa1274/Documents/modemAPI/ModemInterface
ExecStart=/bin/bash -c 'source /home/wapa1274/Documents/modemAPI/ModemInterface/modemAPIEnv/bin/activate && /home/wapa1274/Documents/modemAPI/ModemInterface/modemAPIEnv/bin/python /home/wapa1274/Documents/modemAPI/ModemInterface/ModemApi.py'
Restart=always
Environment=PATH=/home/wapa1274/Documents/modemAPI/ModemInterface/modemAPIEnv/bin
Environment=FLASK_APP=ModemApi.py
StandardOutput=inherit
StandardError=inherit

[Install]
WantedBy=multi-user.target
